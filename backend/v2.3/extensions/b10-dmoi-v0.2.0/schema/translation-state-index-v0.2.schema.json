{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v2.3/translation-state-index-v0.2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_id", "schema_version", "package_id", "dataset_id", "authority_bindings", "coverage", "states", "records", "identity_set_sha256", "no_inference", "recorded_at"],
  "properties": {
    "$schema": {"const": "schema/translation-state-index-v0.2.schema.json"},
    "schema_id": {"const": "interlanguage/global-modular-mathematics-translation-state-index/0.2.0"},
    "schema_version": {"const": "0.2.0"},
    "package_id": {"type": "string"}, "dataset_id": {"type": "string"},
    "authority_bindings": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["course_id", "granularity", "authority_rows", "indexed_rows", "inferred_rows"],
      "properties": {
        "course_id": {"type": "string"}, "granularity": {"type": "string"},
        "authority_rows": {"type": "integer", "minimum": 0}, "indexed_rows": {"type": "integer", "minimum": 0},
        "inferred_rows": {"const": 0}
      }
    },
    "states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "records": {"type": "array", "items": {"type": "object"}},
    "identity_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "no_inference": {"const": true},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
