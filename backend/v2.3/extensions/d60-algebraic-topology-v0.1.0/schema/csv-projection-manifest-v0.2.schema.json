{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v2.3/csv-projection-manifest-v0.2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_id", "schema_version", "package_id", "source_tables", "header", "table_order", "tables", "records_csv", "aggregate_sha256", "canonical_serialization", "recorded_at"],
  "properties": {
    "$schema": {"const": "schema/csv-projection-manifest-v0.2.schema.json"},
    "schema_id": {"const": "interlanguage/global-modular-mathematics-csv-projection-manifest/0.2.0"},
    "schema_version": {"const": "0.2.0"},
    "package_id": {"type": "string"}, "source_tables": {"type": "string"},
    "header": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "table_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tables": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "records_csv": {"type": "object"},
    "aggregate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_serialization": {"type": "object"},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
