        "executable_binding_id": { "$ref": "#/$defs/uuid5_urn" },
        "input_view_mappings": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["native_view", "projection"], "properties": { "native_view": { "type": "string" }, "projection": { "type": "string" } }, "additionalProperties": false } },
        "identity_rules": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 256 } },
