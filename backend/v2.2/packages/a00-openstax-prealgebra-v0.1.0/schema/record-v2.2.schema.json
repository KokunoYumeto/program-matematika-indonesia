        "known_limitations": { "type": "array", "items": { "type": "string", "maxLength": 256 } }
      },
      "additionalProperties": false
    },
    "adapter_run_payload": {
      "type": "object",
      "required": ["adapter_profile_id", "input_manifest_binding_id", "output_manifest_binding_id", "identity_map_binding_id", "build_a_sha256", "build_b_sha256", "deterministic_replay_result", "reverse_extraction_result", "native_input_counts", "projected_output_counts"],
      "properties": {
        "adapter_profile_id": { "$ref": "#/$defs/uuid5_urn" },
