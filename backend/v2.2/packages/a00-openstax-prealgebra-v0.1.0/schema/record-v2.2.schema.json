        "input_binding_ids": { "$ref": "#/$defs/uuid_array" },
        "output_binding_id": { "$ref": "#/$defs/uuid5_urn" },
        "evidence_binding_ids": { "$ref": "#/$defs/uuid_array" },
        "severity_p1": { "type": "integer", "minimum": 0 },
        "severity_p2": { "type": "integer", "minimum": 0 },
        "severity_p3": { "type": "integer", "minimum": 0 },
        "anonymous_readback_state": { "enum": ["pass", "fail", "not_run", "not_applicable", "inherited"] },
        "checked_url": { "$ref": "#/$defs/learner_uri" },
        "checked_at": { "$ref": "#/$defs/date_time" },
        "warnings": { "type": "array", "items": { "type": "string", "maxLength": 256 } },
        "limitation": { "type": "string", "maxLength": 256 }
      },
      "additionalProperties": false
    },
    "identity_crosswalk_payload": {
      "type": "object",
      "required": ["source_schema_name", "source_schema_version", "source_record_type", "source_id", "target_record_type", "target_id", "mapping_state", "mapping_cardinality", "adapter_run_id", "reverse_recipe", "evidence_binding_ids"],
      "properties": {
        "source_schema_name": { "$ref": "#/$defs/nonempty_string" },
