        "reverse_extraction_result": { "const": "pass" },
        "native_input_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "projected_output_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "run_environment_binding_id": { "$ref": "#/$defs/nullable_uuid5_urn" },
