      "additionalProperties": false
    },
    "adapter_profile_payload": {
      "type": "object",
      "required": ["adapter_id", "adapter_version", "native_schema_name", "native_schema_version", "executable_binding_id", "input_view_mappings", "identity_rules", "state_map", "cardinality_rules", "loss_policy", "zero_copy"],
      "properties": {
        "adapter_id": { "$ref": "#/$defs/nonempty_string" },
