      "additionalProperties": false
    },
    "qa_event_payload": {
      "type": "object",
      "required": ["subject_ids", "qa_kind", "result", "method", "input_binding_ids", "output_binding_id", "evidence_binding_ids", "severity_p1", "severity_p2", "severity_p3", "anonymous_readback_state"],
      "properties": {
        "subject_ids": { "$ref": "#/$defs/uuid_array" },
        "qa_kind": { "$ref": "#/$defs/nonempty_string" },
