{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v2.3/namespace-crosswalk-v0.2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_id", "schema_version", "package_id", "profiles", "mappings", "unmaterialized_candidates", "identity_sets", "recorded_at"],
  "properties": {
    "$schema": {"const": "schema/namespace-crosswalk-v0.2.schema.json"},
    "schema_id": {"const": "interlanguage/global-modular-mathematics-namespace-crosswalk/0.2.0"},
    "schema_version": {"const": "0.2.0"},
    "package_id": {"type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$"},
    "profiles": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}},
    "unmaterialized_candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "identity_sets": {"type": "object"},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["source_namespace", "target_namespace", "source_record_id", "target_record_id", "source_record_type", "target_record_type", "cardinality", "mapping_state", "reverse_recipe", "evidence_refs", "identity_set_sha256"],
      "properties": {
        "source_namespace": {"type": "string"}, "target_namespace": {"type": "string"},
        "source_record_id": {"type": "string"}, "target_record_id": {"type": "string"},
        "source_record_type": {"type": "string"}, "target_record_type": {"type": "string"},
        "cardinality": {"enum": ["one_to_one", "one_to_many", "many_to_one", "many_to_many"]},
        "mapping_state": {"const": "mapped"}, "reverse_recipe": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "identity_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace", "record_type", "semantic_key", "candidate_record_id", "state", "formula", "effective_cardinality"],
      "properties": {
        "namespace": {"type": "string"}, "record_type": {"type": "string"}, "semantic_key": {"type": "string"},
        "candidate_record_id": {"type": "string"}, "state": {"const": "deterministic_id_proposal_not_a_mapping"},
        "formula": {"type": "string"}, "effective_cardinality": {"const": "unresolved_until_materialized"}
      }
    }
  }
}
