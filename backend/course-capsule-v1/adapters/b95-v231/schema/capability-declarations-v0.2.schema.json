{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v2.3/capability-declarations-v0.2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_id", "schema_version", "package_id", "dataset_id",
    "contract_binding", "capabilities", "legacy_labels", "namespace_crosswalk_binding",
    "csv_projection_binding", "translation_state_binding", "rights_cross_cutting", "recorded_at"
  ],
  "properties": {
    "$schema": {"const": "schema/capability-declarations-v0.2.schema.json"},
    "schema_id": {"const": "interlanguage/global-modular-mathematics-capability-declarations/0.2.0"},
    "schema_version": {"const": "0.2.0"},
    "package_id": {"$ref": "#/$defs/urnUuid"},
    "dataset_id": {"$ref": "#/$defs/urnUuid"},
    "contract_binding": {"$ref": "#/$defs/authorityFact"},
    "capabilities": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {"$ref": "#/$defs/capability"}
    },
    "legacy_labels": {"type": "array", "items": {"type": "object"}},
    "namespace_crosswalk_binding": {"$ref": "#/$defs/deferredBinding"},
    "csv_projection_binding": {"$ref": "#/$defs/deferredBinding"},
    "translation_state_binding": {"$ref": "#/$defs/deferredBinding"},
    "rights_cross_cutting": {"$ref": "#/$defs/crossCutting"},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "urnUuid": {"type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$"},
    "fileFact": {
      "type": ["object", "null"],
      "required": ["path", "role", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "path_base": {"type": "string"},
        "role": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "records": {"type": "integer", "minimum": 0},
        "record_id_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "authorityFact": {"$ref": "#/$defs/fileFact"},
    "deferredBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "binding_state"],
      "properties": {"path": {"type": "string"}, "binding_state": {"const": "sealed_by_package_manifest"}}
    },
    "lossGap": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"enum": ["closed", "declared_limitation"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": [
        "name", "version", "state", "schema_binding", "shard_refs", "native_count",
        "projected_count", "identity_set_sha256", "identity_set_scope", "closure_rules", "loss_gap_report"
      ],
      "properties": {
        "name": {"enum": ["structure_localization", "terminology", "mathematical_preservation", "assessment_support", "assets", "accessibility", "corrections", "computational_interactives", "publication", "research_support"]},
        "version": {"const": "0.1.0"},
        "state": {"enum": ["materialized", "referenced_native_shards", "not_projected", "absent"]},
        "schema_binding": {"$ref": "#/$defs/fileFact"},
        "shard_refs": {"type": "array", "items": {"$ref": "#/$defs/fileFact"}},
        "native_count": {"type": "integer", "minimum": 0},
        "projected_count": {"type": "integer", "minimum": 0},
        "identity_set_sha256": {"$ref": "#/$defs/sha256"},
        "identity_set_scope": {"enum": ["projected_records", "native_shard_records", "none"]},
        "closure_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "loss_gap_report": {"$ref": "#/$defs/lossGap"}
      }
    },
    "crossCutting": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "shard_refs", "native_count", "identity_set_sha256", "closure_rules"],
      "properties": {
        "state": {"const": "referenced_native_shards"},
        "shard_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileFact"}},
        "native_count": {"type": "integer", "minimum": 1},
        "identity_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "closure_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
