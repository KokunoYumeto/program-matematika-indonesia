  "noncompensable_gates": [
    {
      "gate_id": "O017-WRAP-G01",
      "code": "source_and_version",
      "label_id": "Sumber dan versi",
      "pass_condition_id": "Sumber nyata dan otoritatif mempunyai versi atau representasi beku, lokator, serta dasar hak yang dinyatakan."
    },
    {
      "gate_id": "O017-WRAP-G02",
      "code": "search_provenance",
      "label_id": "Provenance pencarian",
      "pass_condition_id": "Pertanyaan, kueri, waktu, calon, aturan berhenti, keputusan, dan ketidakpastian membentuk rantai lengkap."
    },
    {
      "gate_id": "O017-WRAP-G03",
      "code": "seminar_context",
      "label_id": "Konteks seminar",
      "pass_condition_id": "Acara nyata atau padanan tersupervisi dibuktikan dan diberi label jalur yang tepat."
    },
    {
      "gate_id": "O017-WRAP-G04",
      "code": "human_independence",
      "label_id": "Independensi manusia",
      "pass_condition_id": "Dua ID evaluator mewakili dua manusia berbeda, konflik kepentingan diperiksa, dan atestasi minimal tersedia."
    },
    {
      "gate_id": "O017-WRAP-G05",
      "code": "mathematical_validity",
      "label_id": "Validitas matematika",
      "pass_condition_id": "Klaim, bukti atau reproducer, diagnosis, koreksi, dan batas diperiksa pada sumber atau artefak beku."
    },
    {
      "gate_id": "O017-WRAP-G06",
      "code": "critique_revision_chain",
      "label_id": "Rantai kritik–revisi",
      "pass_condition_id": "Naskah awal, laporan, respons, disposisi, revisi, perbandingan, dan masalah terbuka semuanya terlacak."
    },
    {
      "gate_id": "O017-WRAP-G07",
      "code": "status_and_authorization",
      "label_id": "Status dan otorisasi",
      "pass_condition_id": "Setiap status luar mempunyai bukti peristiwa dan setiap transmisi mempunyai otorisasi khusus yang masih berlaku."
    },
    {
      "gate_id": "O017-WRAP-G08",
      "code": "privacy_and_access",
      "label_id": "Privasi dan akses",
      "pass_condition_id": "Data pribadi diminimalkan; ID evaluator buram; alternatif akses tersedia dan hasil ujinya dicatat."
    },
    {
      "gate_id": "O017-WRAP-G09",
      "code": "evidence_manifest",
      "label_id": "Manifest bukti",
      "pass_condition_id": "Setiap artefak mempunyai ID, lokator, byte, SHA-256, hak, status verifikasi, dan aturan retensi."
    }
  ],
  "controlled_vocabularies": {
    "assessment_status": [
      "not_started",
      "in_progress",
      "ready_for_review",
      "changes_requested",
      "passed",
      "failed",
      "withdrawn",
      "unknown",
      "calibration_only"
    ],
    "gate_status": ["pass", "fail", "not_evaluated", "unknown"],
    "community_lifecycle": [
      "prepared",
      "submitted",
      "acknowledged",
      "accepted",
      "merged",
      "published",
      "rejected",
      "withdrawn",
      "unknown"
    ],
    "comment_disposition": [
      "accepted",
      "partially_accepted",
      "rejected_with_reason",
      "unresolved"
    ],
    "seminar_pathway": ["live_attendance", "live_delivery", "supervised_equivalent"],
    "a05_pathway": ["community_transaction", "externally_reviewed_local"],
    "credential_label": [
      "complete_community_transaction",
      "complete_externally_reviewed_local",
      "incomplete",
      "calibration_only"
    ],
    "evaluator_human_status": ["verified_human", "not_verified", "synthetic_persona"],
    "evidence_verification_status": ["asserted", "observed", "verified", "invalidated", "unknown"]
  },
  "privacy_policy": {
    "public_identifier_form": "opaque_random_identifier",
    "identifier_must_not_be_derived_from_personal_data": true,
    "identity_mapping_in_submission": false,
    "identity_mapping_storage": "separate_encrypted_access_controlled_store",
    "distinctness_attestation_discloses_identity": false,
    "minimum_attestation_fields": [
      "attestation_id",
      "evaluator_id_1",
      "evaluator_id_2",
      "distinct_humans",
      "conflict_checked",
      "attested_at",
      "attestor_role"
    ]
  },
  "accessibility_policy": {
    "audio_only_is_sufficient": false,
    "minimum_alternatives": [
      "structured_text",
      "time_or_section_locators",
      "machine_readable_math",
      "descriptions_for_information_bearing_visuals",
      "non_speech_question_channel"
    ],
    "tested_surface_and_unverified_surface_must_be_distinguished": true
  },
  "contact_policy": {
    "default": "no_contact_no_transmission",
    "local_preparation_allowed": true,
    "authorization_scope": "one_named_transaction",
    "authorization_minimum_fields": [
      "authorization_id",
      "target",
      "artifact_version",
      "channel",
      "responsible_human_sender",
      "personal_data_limit",
      "valid_from",
      "valid_until"
    ],
    "missing_field_means_authorized": false,
    "automation_may_infer_authorization": false
  }
}
