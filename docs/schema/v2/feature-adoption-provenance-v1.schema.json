{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v2/feature-adoption-provenance-v1.schema.json",
  "title": "Seven-layer feature adoption provenance ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "schema_version", "recorded_at", "snapshot_id", "policy", "evidence", "layers"],
  "properties": {
    "$schema": { "const": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v2/feature-adoption-provenance-v1.schema.json" },
    "schema_id": { "const": "interlanguage/program-matematika-indonesia-feature-adoption-provenance/v1" },
    "schema_version": { "const": "1.0.0" },
    "recorded_at": { "type": "string", "format": "date" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course_native_authoritative", "zero_copy", "unsupported_claims_forbidden", "human_evidence_is_not_a_release_gate"],
      "properties": {
        "course_native_authoritative": { "const": true },
        "zero_copy": { "const": true },
        "unsupported_claims_forbidden": { "const": true },
        "human_evidence_is_not_a_release_gate": { "const": true }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "layers": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/layer" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "path", "bytes", "sha256", "claim_scope"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "kind": { "enum": ["immutable_release", "live_overlay_input", "adapter_admission", "adapter_manifest", "adapter_validation", "terminology_evidence", "design_policy", "methodology_record", "generated_snapshot"] },
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "claim_scope": { "type": "string", "minLength": 1 }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "description_id", "source_pattern_ids", "evidence_ids", "implementation_status", "limitations"],
      "properties": {
        "feature_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "description_id": { "type": "string", "minLength": 1 },
        "source_pattern_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_-]+$" } },
        "implementation_status": { "enum": ["implemented", "partially_implemented", "adopted_not_yet_implemented"] },
        "limitations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "layer_id", "label_id", "status", "features"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 7 },
        "layer_id": { "enum": ["curriculum", "translation", "production", "learner", "educator", "federation", "interoperability"] },
        "label_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["adopted_and_implemented", "adopted_partial", "adopted_not_yet_implemented"] },
        "features": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/feature" } }
      }
    }
  }
}
