{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "sha": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v2.3/capability-declarations-v0.1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "capabilities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "closure_rules": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "evidence_notes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "identity_set_scope": {
            "const": "projected_v23_csv_rows"
          },
          "identity_set_sha256": {
            "$ref": "#/$defs/sha"
          },
          "loss_gap_report": {
            "additionalProperties": false,
            "properties": {
              "statement": {
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "enum": [
                  "closed",
                  "declared_limitation",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "status",
              "statement"
            ],
            "type": "object"
          },
          "name": {
            "enum": [
              "structure_localization",
              "terminology",
              "mathematical_preservation",
              "assessment_support",
              "assets",
              "accessibility",
              "corrections",
              "computational_interactives",
              "publication",
              "research_support"
            ]
          },
          "native_count": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "projected_count": {
            "minimum": 0,
            "type": "integer"
          },
          "schema_binding": {
            "$ref": "#/$defs/binding"
          },
          "shard_refs": {
            "items": {
              "$ref": "#/$defs/binding"
            },
            "type": "array"
          },
          "state": {
            "enum": [
              "materialized",
              "referenced_native_shards",
              "not_projected",
              "absent"
            ]
          },
          "version": {
            "const": "0.1.0"
          }
        },
        "required": [
          "name",
          "version",
          "state",
          "schema_binding",
          "shard_refs",
          "native_count",
          "projected_count",
          "identity_set_sha256",
          "closure_rules",
          "loss_gap_report",
          "identity_set_scope",
          "evidence_notes"
        ],
        "type": "object"
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array"
    },
    "contract_binding": {
      "$ref": "#/$defs/binding"
    },
    "csv_projection_binding": {
      "$ref": "#/$defs/binding"
    },
    "dataset_id": {
      "type": "string"
    },
    "legacy_labels": {
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "namespace_crosswalk_binding": {
      "$ref": "#/$defs/binding"
    },
    "package_id": {
      "pattern": "^urn:uuid:[0-9a-f-]{36}$",
      "type": "string"
    },
    "package_version": {
      "const": "0.1.1"
    },
    "recorded_at": {
      "const": "2026-08-29T00:00:00Z"
    },
    "schema_id": {
      "const": "interlanguage/backend-v2.3-capability-declarations/0.1.0"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "translation_state_binding": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "minItems": 2,
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "schema_id",
    "schema_version",
    "package_version",
    "package_id",
    "dataset_id",
    "contract_binding",
    "capabilities",
    "legacy_labels",
    "namespace_crosswalk_binding",
    "csv_projection_binding",
    "translation_state_binding",
    "recorded_at"
  ],
  "title": "Additive backend v2.3 capability declarations",
  "type": "object"
}
