{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v2.3/scope-declaration-v0.2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_id", "schema_version", "package_id", "dataset_id", "scope_kind", "course_ids", "curriculum_role_ids", "aggregate_conformance_claim", "unbound_curriculum_role_ids", "owner_authority_binding", "curriculum_authority_binding", "limitations", "recorded_at"],
  "properties": {
    "$schema": {"const": "schema/scope-declaration-v0.2.schema.json"},
    "schema_id": {"const": "interlanguage/global-modular-mathematics-backend-scope/0.2.0"},
    "schema_version": {"const": "0.2.0"},
    "package_id": {"type": "string"}, "dataset_id": {"type": "string"},
    "scope_kind": {"const": "lane_adapter"},
    "course_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "curriculum_role_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "aggregate_conformance_claim": {"const": false},
    "unbound_curriculum_role_ids": {"type": "array", "items": {"type": "string"}},
    "owner_authority_binding": {"type": "object"},
    "curriculum_authority_binding": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
