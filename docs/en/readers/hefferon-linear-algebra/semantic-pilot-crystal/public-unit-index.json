    "rules": [
      {
        "id": "r005.hefferon-linear-algebra.context.finite-dimensional-book-convention",
        "kind": "source_declared_book_convention",
        "title": "Finite-dimensional vector-space convention",
        "origin": {
          "native_unit_id": null,
          "source": {
