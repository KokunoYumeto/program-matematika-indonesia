  "editorial_notes": [
    {
      "id": "B40-NETWORK-SOURCE-001",
      "kind": "original_source_observation",
      "affected_unit_ids": [
        "r005.hefferon-linear-algebra.unit.file.src.gr.network.tex.exercise.source-order.10004.answer.source-order.001"
      ],
      "reader_anchor": "network-source-note-1",
      "text": "The traffic-circle question gives cars per ten minutes, while answer (e) says five minutes. Both passages are preserved; use the question’s ten-minute unit when interpreting the data.",
      "evidence_sha256": "61b16983dab42be02e0115baba801f3fa20bd6dacf97f3288af42f6a23c2f92d"
    },
    {
      "id": "B40-NETWORK-SOURCE-002",
      "kind": "original_source_observation",
      "affected_unit_ids": [
        "r005.hefferon-linear-algebra.unit.file.src.gr.network.tex.exercise.source-order.10005.answer.source-order.001"
      ],
      "reader_anchor": "network-source-note-2",
      "text": "Exercise 5’s prose states i1+25=i2+125, implying i1−i2=100. Its immediately following system instead uses i1−i2=10. The table and labelled intersection give i1+65=i2+75, supporting the system’s 10, not the prose’s 100. Original text and system remain unchanged.",
      "evidence_sha256": "61b16983dab42be02e0115baba801f3fa20bd6dacf97f3288af42f6a23c2f92d"
    },
    {
      "id": "B40-NETWORK-CONDITION-001",
      "kind": "original_source_observation",
      "affected_unit_ids": [
        "r005.hefferon-linear-algebra.unit.file.src.gr.network.tex.exercise.label.39468f525c46875bb85a.answer.source-order.001"
      ],
      "reader_anchor": "network-source-note-3",
      "text": "The Wheatstone-bridge derivation divides by branch currents and resistances. The stated resistance ratio uses the physical assumptions of nonzero excitation and positive resistances; if every current is zero, zero detector current alone does not determine that ratio.",
      "evidence_sha256": "61b16983dab42be02e0115baba801f3fa20bd6dacf97f3288af42f6a23c2f92d"
    }
  ],
