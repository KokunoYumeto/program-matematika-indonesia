{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenodo.org/records/22060393/files/program-matematika-indonesia-catalog-v1.schema.json",
  "title": "Program Matematika Indonesia — katalog rilis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "snapshotDate",
    "sourceCommit",
    "program",
    "topics",
    "counts",
    "courses"
  ],
  "properties": {
    "$schema": { "const": "https://zenodo.org/records/22060393/files/program-matematika-indonesia-catalog-v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "snapshotDate": { "type": "string", "format": "date" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "program": { "$ref": "#/$defs/program" },
    "topics": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["courseRoles", "selectedCorpusRoles", "unresolvedRoles", "completedPublicCourseRoles", "completedPublicRecords"],
      "properties": {
        "courseRoles": { "const": 40 },
        "selectedCorpusRoles": { "const": 40 },
        "unresolvedRoles": { "const": 0 },
        "completedPublicCourseRoles": { "const": 8 },
        "completedPublicRecords": { "const": 7 }
      }
    },
    "courses": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/course" }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "language", "version", "snapshotDate", "totalCourseRoles", "selectedCorpusRoles", "unresolvedRoleIds", "completedPublicCourseRoleIds", "completedPublicRecordDois", "zenodo", "zenodoConcept", "repositories", "backend", "status"],
      "properties": {
        "id": { "const": "program-matematika-indonesia" },
        "title": { "type": "string", "minLength": 1 },
        "language": { "const": "id-ID" },
        "version": { "const": "0.41.0" },
        "snapshotDate": { "type": "string", "format": "date" },
        "totalCourseRoles": { "const": 40 },
        "selectedCorpusRoles": { "const": 40 },
        "unresolvedRoleIds": {
          "type": "array",
          "maxItems": 0
        },
        "completedPublicCourseRoleIds": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-D][0-9]{2,3}$" }
        },
        "completedPublicRecordDois": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^10\\.5281/zenodo\\.[0-9]+$" }
        },
        "zenodo": { "$ref": "#/$defs/httpsUrl" },
        "zenodoConcept": { "$ref": "#/$defs/httpsUrl" },
        "repositories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["github"],
          "properties": {
            "github": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "status", "lastConfirmedAt"],
              "properties": {
                "url": { "$ref": "#/$defs/httpsUrl" },
                "status": { "enum": ["available", "temporarily-unavailable"] },
                "lastConfirmedAt": { "type": "string", "format": "date" }
              }
            }
          }
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "status", "centralRecordCount", "completeCorpusMigration", "schema", "sourceFormatProfile", "package"],
          "properties": {
            "schemaVersion": { "const": "1.0.0" },
            "status": { "const": "validated" },
            "centralRecordCount": { "const": 2122 },
            "completeCorpusMigration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["corpus", "recordCount", "result"],
              "properties": {
                "corpus": { "type": "string", "minLength": 1 },
                "recordCount": { "const": 163583 },
                "result": { "const": "lossless-zero-copy-pass" }
              }
            },
            "schema": { "$ref": "#/$defs/httpsUrl" },
            "sourceFormatProfile": { "$ref": "#/$defs/httpsUrl" },
            "package": { "$ref": "#/$defs/httpsUrl" }
          }
        },
        "status": { "const": "in-progress" }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "topic", "state", "title", "prerequisites", "purpose", "outcome", "corpus", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-D][0-9]{2,3}$" },
        "level": { "enum": ["A", "B", "C", "D"] },
        "topic": { "type": "string", "minLength": 1 },
        "state": { "enum": ["published", "near", "production", "unresolved"] },
        "title": { "type": "string", "minLength": 1 },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-D][0-9]{2,3}$" }
        },
        "purpose": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "corpus": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "edition": { "$ref": "#/$defs/httpsUrl" },
        "repository": { "$ref": "#/$defs/httpsUrl" },
        "zenodo": { "$ref": "#/$defs/httpsUrl" }
      }
    }
  }
}
