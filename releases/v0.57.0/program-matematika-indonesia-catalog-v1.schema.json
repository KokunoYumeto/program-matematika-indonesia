{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenodo.org/records/22104174/files/program-matematika-indonesia-catalog-v1.schema.json",
  "title": "Program Matematika Indonesia — katalog rilis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "snapshotDate",
    "sourceCommit",
    "program",
    "topics",
    "counts",
    "courses"
  ],
  "properties": {
    "$schema": { "type": "string", "pattern": "^https://zenodo\\.org/records/[0-9]+/files/program-matematika-indonesia-catalog-v1\\.schema\\.json$" },
    "schemaVersion": { "const": 1 },
    "snapshotDate": { "type": "string", "format": "date" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "program": { "$ref": "#/$defs/program" },
    "topics": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["courseRoles", "selectedCorpusRoles", "unresolvedRoles", "completedPublicCourseRoles", "completedPublicRecords"],
      "properties": {
        "courseRoles": { "const": 40 },
        "selectedCorpusRoles": { "const": 40 },
        "unresolvedRoles": { "const": 0 },
        "completedPublicCourseRoles": { "type": "integer", "minimum": 0, "maximum": 40 },
        "completedPublicRecords": { "type": "integer", "minimum": 0 }
      }
    },
    "courses": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/course" }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "language", "version", "snapshotDate", "totalCourseRoles", "selectedCorpusRoles", "unresolvedRoleIds", "completedPublicCourseRoleIds", "completedPublicRecordDois", "website", "zenodo", "zenodoConcept", "provenance", "repositories", "backend", "status"],
      "properties": {
        "id": { "const": "program-matematika-indonesia" },
        "title": { "type": "string", "minLength": 1 },
        "language": { "const": "id-ID" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "snapshotDate": { "type": "string", "format": "date" },
        "totalCourseRoles": { "const": 40 },
        "selectedCorpusRoles": { "const": 40 },
        "unresolvedRoleIds": {
          "type": "array",
          "maxItems": 0
        },
        "completedPublicCourseRoleIds": {
          "type": "array",
          "maxItems": 40,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-D][0-9]{2,3}$" }
        },
        "completedPublicRecordDois": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^10\\.5281/zenodo\\.[0-9]+$" }
        },
        "website": { "$ref": "#/$defs/httpsUrl" },
        "zenodo": { "$ref": "#/$defs/httpsUrl" },
        "zenodoConcept": { "$ref": "#/$defs/httpsUrl" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "role"],
          "properties": {
            "model": { "const": "OpenAI Codex gpt-5.6-sol, Ultra" },
            "role": { "type": "string", "minLength": 1 }
          }
        },
        "repositories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["github"],
          "properties": {
            "github": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "status", "lastConfirmedAt"],
              "properties": {
                "url": { "$ref": "#/$defs/httpsUrl" },
                "status": { "enum": ["available", "temporarily-unavailable"] },
                "lastConfirmedAt": { "type": "string", "format": "date" }
              }
            }
          }
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "status", "centralRecordCount", "completeCorpusMigrations", "schema", "sourceFormatProfile", "package", "federationV2", "federationV21", "educationalAccessResearch", "learnerReadModelV1"],
          "properties": {
            "schemaVersion": { "const": "1.0.0" },
            "status": { "const": "validated" },
            "centralRecordCount": { "type": "integer", "minimum": 1 },
            "completeCorpusMigrations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["corpus", "recordCount", "result"],
                "properties": {
                  "corpus": { "type": "string", "minLength": 1 },
                  "recordCount": { "type": "integer", "minimum": 1 },
                  "result": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-pass$"
                  }
                }
              }
            },
            "schema": { "$ref": "#/$defs/httpsUrl" },
            "sourceFormatProfile": { "$ref": "#/$defs/httpsUrl" },
            "package": { "$ref": "#/$defs/httpsUrl" },
            "federationV2": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "status", "recordCount", "datasetCount", "courseCount", "learnerSurfaceCount", "webRouteCount", "identityCrosswalkCount", "package", "packageSchema", "recordSchema", "validationReceipt"],
              "properties": {
                "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
                "status": { "const": "validated" },
                "recordCount": { "type": "integer", "minimum": 2434 },
                "datasetCount": { "const": 34 },
                "courseCount": { "const": 40 },
                "learnerSurfaceCount": { "type": "integer", "minimum": 128 },
                "webRouteCount": { "const": 41 },
                "identityCrosswalkCount": { "const": 2122 },
                "package": { "$ref": "#/$defs/httpsUrl" },
                "packageSchema": { "$ref": "#/$defs/httpsUrl" },
                "recordSchema": { "$ref": "#/$defs/httpsUrl" },
                "validationReceipt": { "$ref": "#/$defs/httpsUrl" }
              }
            },
            "federationV21": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "status", "pilot_courses", "pilot_units", "pilot_relations", "route_wrapper_course", "route_wrapper_courses", "educational_access_planning", "packageSchema", "recordSchema", "package"],
              "properties": {
                "version": { "const": "2.1.0" },
                "status": { "const": "pilot_validated" },
                "pilot_courses": {
                  "type": "array",
                  "const": ["A00", "B10", "C100", "D20"]
                },
                "pilot_units": { "const": 1194 },
                "pilot_relations": { "const": 2165 },
                "route_wrapper_course": { "const": "D20" },
                "route_wrapper_courses": {
                  "type": "array",
                  "const": ["C100", "D20"]
                },
                "educational_access_planning": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schema_id", "dataset_id", "status", "curriculum_unit_count", "portfolio_count", "portfolio_relation_count", "adaptation_depth_count", "accessibility_derivative_count", "compute_assumption_count", "compute_scenario_count"],
                  "properties": {
                    "schema_id": { "const": "interlanguage/global-backend-v2.1-educational-access-planning/0.1.0" },
                    "dataset_id": { "const": "planning:educational-access:v2.1:0.1.0" },
                    "status": { "const": "validated" },
                    "curriculum_unit_count": { "const": 29 },
                    "portfolio_count": { "const": 13 },
                    "portfolio_relation_count": { "const": 10 },
                    "adaptation_depth_count": { "const": 5 },
                    "accessibility_derivative_count": { "const": 8 },
                    "compute_assumption_count": { "const": 12 },
                    "compute_scenario_count": { "const": 3 }
                  }
                },
                "packageSchema": { "$ref": "#/$defs/httpsUrl" },
                "recordSchema": { "$ref": "#/$defs/httpsUrl" },
                "package": { "$ref": "#/$defs/httpsUrl" }
              }
            },
            "educationalAccessResearch": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "status", "record_count", "materialized_table_count", "declared_unmaterialized_table_count", "publicCatalog", "schema", "sourcePackage"],
              "properties": {
                "version": { "const": "0.1.0" },
                "status": { "const": "frozen_validated" },
                "record_count": { "const": 490 },
                "materialized_table_count": { "const": 10 },
                "declared_unmaterialized_table_count": { "const": 7 },
                "publicCatalog": { "$ref": "#/$defs/httpsUrl" },
                "schema": { "$ref": "#/$defs/httpsUrl" },
                "sourcePackage": { "$ref": "#/$defs/httpsUrl" }
              }
            },
            "learnerReadModelV1": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "status", "courseCount", "prerequisiteEdgeCount", "authority", "authoritySchema", "readModel", "readModelSchema", "validationReceipt", "publicEndpoint"],
              "properties": {
                "version": { "const": "1.0.0" },
                "status": { "const": "validated" },
                "courseCount": { "const": 40 },
                "prerequisiteEdgeCount": { "const": 82 },
                "authority": { "$ref": "#/$defs/httpsUrl" },
                "authoritySchema": { "$ref": "#/$defs/httpsUrl" },
                "readModel": { "$ref": "#/$defs/httpsUrl" },
                "readModelSchema": { "$ref": "#/$defs/httpsUrl" },
                "validationReceipt": { "$ref": "#/$defs/httpsUrl" },
                "publicEndpoint": { "$ref": "#/$defs/httpsUrl" }
              }
            }
          }
        },
        "status": { "const": "in-progress" }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ownerLane", "level", "topic", "state", "title", "prerequisites", "purpose", "outcome", "corpus", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-D][0-9]{2,3}$" },
        "ownerLane": { "type": "string", "pattern": "^(?:R[0-9]{3}(?:-R[0-9]{3})?|O[0-9]{3}|LEAN|OPENSTAX-(?:ELEMENTARY|INTERMEDIATE))$" },
        "level": { "enum": ["A", "B", "C", "D"] },
        "topic": { "type": "string", "minLength": 1 },
        "state": { "enum": ["published", "near", "production", "unresolved"] },
        "title": { "type": "string", "minLength": 1 },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-D][0-9]{2,3}$" }
        },
        "purpose": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "corpus": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "reader": { "$ref": "#/$defs/httpsUrl" },
        "edition": { "$ref": "#/$defs/httpsUrl" },
        "repository": { "$ref": "#/$defs/httpsUrl" },
        "zenodo": { "$ref": "#/$defs/httpsUrl" }
      }
    }
  }
}
