{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v1/learner-state-v1.schema.json",
  "title": "Program Matematika Indonesia learner state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaId",
    "schemaVersion",
    "updatedAt",
    "completedCourseIds",
    "placementClaims",
    "equivalenceClaims",
    "waivers"
  ],
  "properties": {
    "$schema": {
      "const": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v1/learner-state-v1.schema.json"
    },
    "schemaId": {
      "const": "interlanguage/program-matematika-indonesia-learner-state/v1"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "updatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "completedCourseIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/courseId" }
    },
    "placementClaims": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/courseClaim" }
    },
    "equivalenceClaims": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/courseClaim" }
    },
    "waivers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/waiver" }
    }
  },
  "$defs": {
    "courseId": {
      "type": "string",
      "pattern": "^[A-D][0-9]{2,3}$"
    },
    "courseClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["courseId"],
      "properties": {
        "courseId": { "$ref": "#/$defs/courseId" }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetCourseId", "prerequisiteCourseId"],
      "properties": {
        "targetCourseId": { "$ref": "#/$defs/courseId" },
        "prerequisiteCourseId": { "$ref": "#/$defs/courseId" }
      }
    }
  }
}
