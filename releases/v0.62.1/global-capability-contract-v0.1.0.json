{
  "$schema": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v2.2/global-capability-contract-v0.1.schema.json",
  "schema_id": "interlanguage/global-modular-mathematics-capability-contract/0.1.0",
  "contract_version": "0.1.0",
  "identity": {
    "namespace": "0e4d7b37-6108-5065-b08f-d1098697cc02",
    "formula": "UUIDv5(namespace, record_type + ':' + corpus_qualified_semantic_key)",
    "locale_independent": true,
    "priority": ["stable_native_id", "authority_qualified_source_id", "pinned_file_and_structural_selector"],
    "forbidden_inputs": ["translated_title", "translated_prose", "url", "page_number", "line_number", "locale", "build_time", "mutable_order"]
  },
  "layers": [
    {
      "id": "owner_native_authority",
      "authority": "owner",
      "centralizes_full_prose": false,
      "purpose": "Canonical prose, formulas, assets, rights, corrections, build workflow, native identities, and owner-native states."
    },
    {
      "id": "lane_authority_capsule",
      "authority": "lane",
      "centralizes_full_prose": false,
      "purpose": "Strict bindings for native manifests, source/target bytes, schemas, adapters, builders, state maps, reverse recipes, capability inventory, and loss reports."
    },
    {
      "id": "semantic_capability_shards",
      "authority": "lane",
      "centralizes_full_prose": false,
      "purpose": "Optional sealed and reversible shards for structure, localization, terminology, formulas, assessments, assets, accessibility, corrections, computation, publication, and research evidence."
    },
    {
      "id": "learner_navigation_shard",
      "authority": "lane",
      "centralizes_full_prose": false,
      "purpose": "Compact learner-visible units, memberships, search metadata, selected relations, reader surfaces, and truthful route outcomes."
    },
    {
      "id": "global_registry",
      "authority": "program",
      "centralizes_full_prose": false,
      "purpose": "Programs, courses, owners, editions, package and shard references, crosswalks, release snapshots, rights summaries, QA, publication events, and compact navigation."
    },
    {
      "id": "student_site",
      "authority": "generated",
      "centralizes_full_prose": false,
      "purpose": "Primary human-facing curriculum and learner entry that opens readable HTML/MathML, an accessible wrapper, an honest fallback, or a downloadable edition."
    }
  ],
  "lane_required_records": ["owner_authority", "dataset", "edition", "native_binding", "content_binding", "adapter_profile", "adapter_run", "identity_crosswalk", "rights", "rights_assignment", "qa_event"],
  "human_course_required_records": ["unit", "course_unit_membership", "search_document", "reader_surface", "route"],
  "global_registry_records": ["program", "course", "owner_authority", "dataset", "edition", "package_ref", "shard_ref", "identity_crosswalk", "release_snapshot", "rights", "rights_assignment", "qa_event", "publication_event", "unit", "course_unit_membership", "search_document", "reader_surface", "route"],
  "capability_profiles": [
    { "name": "structure_localization", "version": "0.1.0", "states": ["materialized", "referenced_native_shards", "not_projected", "absent"], "required_declaration_fields": ["name", "version", "state", "schema_binding", "shard_refs", "native_count", "projected_count", "identity_set_sha256", "closure_rules", "loss_gap_report"] },
    { "name": "terminology", "version": "0.1.0", "states": ["materialized", "referenced_native_shards", "not_projected", "absent"], "required_declaration_fields": ["name", "version", "state", "schema_binding", "shard_refs", "native_count", "projected_count", "identity_set_sha256", "closure_rules", "loss_gap_report"] },
    { "name": "mathematical_preservation", "version": "0.1.0", "states": ["materialized", "referenced_native_shards", "not_projected", "absent"], "required_declaration_fields": ["name", "version", "state", "schema_binding", "shard_refs", "native_count", "projected_count", "identity_set_sha256", "closure_rules", "loss_gap_report"] },
    { "name": "assessment_support", "version": "0.1.0", "states": ["materialized", "referenced_native_shards", "not_projected", "absent"], "required_declaration_fields": ["name", "version", "state", "schema_binding", "shard_refs", "native_count", "projected_count", "identity_set_sha256", "closure_rules", "loss_gap_report"], "component_kinds": ["statement", "subpart", "hint", "answer", "solution", "worked_solution", "rubric", "dataset", "notebook"] },
    { "name": "assets", "version": "0.1.0", "states": ["materialized", "referenced_native_shards", "not_projected", "absent"], "required_declaration_fields": ["name", "version", "state", "schema_binding", "shard_refs", "native_count", "projected_count", "identity_set_sha256", "closure_rules", "loss_gap_report"] },
    { "name": "accessibility", "version": "0.1.0", "states": ["materialized", "referenced_native_shards", "not_projected", "absent"], "required_declaration_fields": ["name", "version", "state", "schema_binding", "shard_refs", "native_count", "projected_count", "identity_set_sha256", "closure_rules", "loss_gap_report"] },
    { "name": "corrections", "version": "0.1.0", "states": ["materialized", "referenced_native_shards", "not_projected", "absent"], "required_declaration_fields": ["name", "version", "state", "schema_binding", "shard_refs", "native_count", "projected_count", "identity_set_sha256", "closure_rules", "loss_gap_report"] },
    { "name": "computational_interactives", "version": "0.1.0", "states": ["materialized", "referenced_native_shards", "not_projected", "absent"], "required_declaration_fields": ["name", "version", "state", "schema_binding", "shard_refs", "native_count", "projected_count", "identity_set_sha256", "closure_rules", "loss_gap_report"] },
    { "name": "publication", "version": "0.1.0", "states": ["materialized", "referenced_native_shards", "not_projected", "absent"], "required_declaration_fields": ["name", "version", "state", "schema_binding", "shard_refs", "native_count", "projected_count", "identity_set_sha256", "closure_rules", "loss_gap_report"] },
    { "name": "research_support", "version": "0.1.0", "states": ["materialized", "referenced_native_shards", "not_projected", "absent"], "required_declaration_fields": ["name", "version", "state", "schema_binding", "shard_refs", "native_count", "projected_count", "identity_set_sha256", "closure_rules", "loss_gap_report"] }
  ],
  "learner_route_policy": {
    "action_order": ["learn", "html", "pdf", "epub", "offline", "source"],
    "allowed_results": ["exact_anchor", "truthful_fallback", "explicit_unavailable"],
    "machine_data_is_learner_destination": false,
    "fresh_public_readback_required_for_public_claim": true
  },
  "validation_gates": ["G0_schema_inventory", "G1_authority_bytes", "G2_identity_native_mapping", "G3_relation_closure", "G4_source_target_preservation", "G5_capability_closure", "G6_rights_accessibility", "G7_reverse_extraction", "G8_deterministic_replay", "G9_learner_route_qa", "G10_publication_readback", "G11_aggregate_differential"],
  "policies": {
    "owner_native_authoritative": true,
    "zero_copy_global_registry": true,
    "semantic_translation_navigation_are_distinct": true,
    "capabilities_are_conditional": true,
    "missing_capability_is_explicit": true,
    "student_site_is_primary_entry": true,
    "json_is_secondary_machine_surface": true
  }
}
