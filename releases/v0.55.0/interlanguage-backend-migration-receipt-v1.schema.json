{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doi.org/10.5281/zenodo.22059707/schema/backend-migration-receipt-v1.schema.json",
  "title": "Interlanguage mathematics backend migration receipt v1",
  "description": "Common proof envelope for additive or lossless corpus migrations into the interlanguage mathematics modular backend v1 contract.",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "migration_id",
    "migration_mode",
    "source",
    "target",
    "transformation",
    "validation"
  ],
  "properties": {
    "schema_name": {
      "const": "interlanguage-math-modular-backend-migration-receipt"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "migration_id": {
      "type": "string",
      "minLength": 1
    },
    "migration_mode": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "minProperties": 1
    },
    "target": {
      "type": "object",
      "required": [
        "dataset_id",
        "dataset_version",
        "schema_name",
        "schema_version",
        "record_count"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        },
        "schema_name": {
          "const": "interlanguage-math-modular-backend"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "virtual_records_jsonl_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": true
    },
    "transformation": {
      "type": "object",
      "minProperties": 1
    },
    "validation": {
      "type": "object",
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "const": "pass"
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object"
    },
    "tables": {
      "type": "object"
    },
    "materialization": {
      "type": "object"
    },
    "public_artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "credentials_recorded": {
      "const": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
