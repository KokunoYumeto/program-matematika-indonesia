# Mesin pertukaran kapsul menggunakan NDJSON kanonis, bukan biner generik.
/hub/data/course-capsule-v1/course-capsules.jsonl
  Content-Type: application/x-ndjson; charset=utf-8
  X-Content-Type-Options: nosniff

/hub/data/*.json
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff

/hub/data/*/*.json
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff

/hub/schema/*.json
  Content-Type: application/schema+json; charset=utf-8
  X-Content-Type-Options: nosniff

/hub/schema/*/*.json
  Content-Type: application/schema+json; charset=utf-8
  X-Content-Type-Options: nosniff

/hub/schema/*/*/*.json
  Content-Type: application/schema+json; charset=utf-8
  X-Content-Type-Options: nosniff
