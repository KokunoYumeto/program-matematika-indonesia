{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v1/learner-read-model-v1.schema.json",
  "title": "Program Matematika Indonesia learner read model v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "schema_version", "locale", "provenance", "policy", "program", "topics", "courses", "nextCourseIdsById", "summary"],
  "properties": {
    "$schema": { "const": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v1/learner-read-model-v1.schema.json" },
    "schema_id": { "const": "interlanguage/program-matematika-indonesia-learner-read-model/v1" },
    "schema_version": { "const": "1.0.0" },
    "locale": { "const": "id-ID" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_path", "authority_bytes", "authority_sha256", "federation_records_path", "federation_records_bytes", "federation_records_sha256", "federation_validation_report_path", "federation_validation_report_sha256", "federation_validation_result", "readback_overlay_count"],
      "properties": {
        "authority_path": { "$ref": "#/$defs/portablePath" },
        "authority_bytes": { "type": "integer", "minimum": 1 },
        "authority_sha256": { "$ref": "#/$defs/sha256" },
        "federation_records_path": { "$ref": "#/$defs/portablePath" },
        "federation_records_bytes": { "type": "integer", "minimum": 1 },
        "federation_records_sha256": { "$ref": "#/$defs/sha256" },
        "federation_validation_report_path": { "$ref": "#/$defs/portablePath" },
        "federation_validation_report_sha256": { "$ref": "#/$defs/sha256" },
        "federation_validation_result": { "const": "pass" },
        "readback_overlay_count": { "type": "integer", "minimum": 0 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learner_action_order", "technical_action_order", "raw_json_is_learner_start", "internal_workflow_locators_are_public_authority", "source_and_effective_publication_states_are_distinct"],
      "properties": {
        "learner_action_order": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "technical_action_order": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "raw_json_is_learner_start": { "const": false },
        "internal_workflow_locators_are_public_authority": { "const": false },
        "source_and_effective_publication_states_are_distinct": { "const": true }
      }
    },
    "program": { "type": "object", "required": ["id", "version", "website", "zenodo", "backend"] },
    "topics": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "courses": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["id", "ownerLane", "level", "topic", "state", "title", "prerequisites", "purpose", "outcome", "corpus", "note", "federation"],
        "properties": {
          "id": { "$ref": "#/$defs/courseId" },
          "ownerLane": { "type": "string", "minLength": 1 },
          "level": { "enum": ["A", "B", "C", "D"] },
          "topic": { "type": "string", "minLength": 1 },
          "state": { "enum": ["published", "near", "production", "unresolved"] },
          "title": { "type": "string", "minLength": 1 },
          "prerequisites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/courseId" } },
          "purpose": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 },
          "corpus": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 },
          "reader": { "type": "string", "format": "uri" },
          "edition": { "type": "string", "format": "uri" },
          "repository": { "type": "string", "format": "uri" },
          "zenodo": { "type": "string", "format": "uri" },
          "federation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["course_record_id", "course_semantic_key", "owner_dataset_id", "owner_dataset_semantic_key", "primary_surface_id", "primary_source_publication_state", "primary_effective_publication_state", "primary_readback", "planned_unit_route_pattern", "unit_route_state", "web_route_id", "action_surfaces"],
            "properties": {
              "course_record_id": { "$ref": "#/$defs/uuidUrn" },
              "course_semantic_key": { "type": "string", "minLength": 1 },
              "owner_dataset_id": { "$ref": "#/$defs/uuidUrn" },
              "owner_dataset_semantic_key": { "type": "string", "minLength": 1 },
              "primary_surface_id": { "$ref": "#/$defs/uuidUrn" },
              "primary_source_publication_state": { "type": "string", "minLength": 1 },
              "primary_effective_publication_state": { "enum": ["public", "catalog_declared", "planned_not_published"] },
              "primary_readback": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/readback" }] },
              "planned_unit_route_pattern": { "type": "string", "minLength": 1 },
              "unit_route_state": { "type": "string", "minLength": 1 },
              "web_route_id": { "$ref": "#/$defs/uuidUrn" },
              "action_surfaces": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/surface" } } }
            }
          }
        }
      }
    },
    "nextCourseIdsById": {
      "type": "object",
      "minProperties": 40,
      "maxProperties": 40,
      "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/courseId" } }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course_count", "dataset_count", "reader_surface_count", "dedicated_html_reader_count", "direct_edition_count", "planned_unit_route_count", "published_course_count", "effective_public_primary_count", "readback_overlay_count"],
      "properties": {
        "course_count": { "const": 40 },
        "dataset_count": { "const": 34 },
        "reader_surface_count": { "type": "integer", "minimum": 126 },
        "dedicated_html_reader_count": { "type": "integer", "minimum": 0 },
        "direct_edition_count": { "type": "integer", "minimum": 0 },
        "planned_unit_route_count": { "type": "integer", "minimum": 0 },
        "published_course_count": { "type": "integer", "minimum": 0 },
        "effective_public_primary_count": { "type": "integer", "minimum": 0 },
        "readback_overlay_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "courseId": { "type": "string", "pattern": "^[A-D][0-9]{2,3}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuidUrn": { "type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$" },
    "portablePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_kind", "bytes", "sha256", "verified_at"],
      "properties": {
        "evidence_kind": { "const": "anonymous_public_byte_readback" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_id", "semantic_key", "actions", "format", "locale", "source_publication_state", "effective_publication_state", "url", "evidence_kind", "evidence_locator", "evidence_sha256", "readback"],
      "properties": {
        "surface_id": { "$ref": "#/$defs/uuidUrn" },
        "semantic_key": { "type": "string", "minLength": 1 },
        "actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "format": { "type": "string", "minLength": 1 },
        "locale": { "type": ["string", "null"] },
        "source_publication_state": { "type": "string", "minLength": 1 },
        "effective_publication_state": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "evidence_kind": { "type": "string", "minLength": 1 },
        "evidence_locator": { "type": ["string", "null"] },
        "evidence_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "readback": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/readback" }] }
      }
    }
  }
}
