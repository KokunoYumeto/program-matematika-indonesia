{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v1/clp-effective-course-routes-v1.schema.json",
  "title": "CLP v2.3.1 effective learner-route projection",
  "description": "Versioned, zero-copy effective routes derived from the sealed CLP learner evidence. The projection repairs stale learner links without claiming adapter consumption or fine-grained anchors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_id", "schema_version", "projection_id", "snapshot_id", "status", "locale", "source_precedence", "source", "base_capsules", "sidecar", "policy", "courses", "summary"],
  "properties": {
    "$schema": { "const": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/v1/clp-effective-course-routes-v1.schema.json" },
    "schema_id": { "const": "interlanguage/clp-effective-course-routes/v1" },
    "schema_version": { "const": "1.0.0" },
    "projection_id": { "type": "string", "pattern": "^urn:interlanguage:clp-effective-course-routes:v1:[0-9a-f]{24}$" },
    "snapshot_id": { "type": ["string", "null"] },
    "status": { "const": "staged_successor_projection" },
    "locale": { "const": "id-ID" },
    "source_precedence": { "const": "sealed_route_evidence_over_mutable_overlay" },
    "source": { "$ref": "#/$defs/identity" },
    "base_capsules": { "$ref": "#/$defs/identity" },
    "sidecar": { "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learner_primary_is_pdf", "route_granularity", "anchors_claimed", "html_claimed", "epub_claimed", "portable_html_claimed", "machine_data_is_learner_destination", "adapter_consumption_claim", "zero_copy"],
      "properties": {
        "learner_primary_is_pdf": { "const": true },
        "route_granularity": { "const": "whole_file_only" },
        "anchors_claimed": { "const": false },
        "html_claimed": { "const": false },
        "epub_claimed": { "const": false },
        "portable_html_claimed": { "const": false },
        "machine_data_is_learner_destination": { "const": false },
        "adapter_consumption_claim": { "const": false },
        "zero_copy": { "const": true }
      }
    },
    "courses": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/course" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course_count", "action_count", "pages", "bytes", "verified_action_count", "route_granularity", "native_html_claimed", "chapter_or_unit_routes_claimed"],
      "properties": {
        "course_count": { "const": 4 },
        "action_count": { "const": 7 },
        "pages": { "const": 4077 },
        "bytes": { "const": 35639691 },
        "verified_action_count": { "const": 7 },
        "route_granularity": { "const": "whole_file_only" },
        "native_html_claimed": { "const": false },
        "chapter_or_unit_routes_claimed": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:[\\\\/])(?!\\\\\\\\)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "verification_scope": { "type": "string" },
        "sealed_authority": { "$ref": "#/$defs/identity" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "version_doi", "concept_doi", "version", "record_url", "access_right", "license"],
      "properties": {
        "record_id": { "type": "integer", "minimum": 1 },
        "version_doi": { "type": "string", "pattern": "^10\\.5281/zenodo\\.[0-9]+$" },
        "concept_doi": { "type": "string", "pattern": "^10\\.5281/zenodo\\.[0-9]+$" },
        "version": { "type": "string", "minLength": 1 },
        "record_url": { "$ref": "#/$defs/httpsUrl" },
        "access_right": { "const": "open" },
        "license": { "const": "cc-by-nc-sa-4.0" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "status"],
      "properties": {
        "kind": { "const": "receipt_bound_anonymous_public_readback" },
        "locator": { "$ref": "#/$defs/httpsUrl" },
        "status": { "const": "pass_receipt_bound" },
        "record_id": { "type": "integer", "minimum": 1 },
        "source_json_pointer": { "type": "string" },
        "version_doi": { "type": "string" }
      }
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_fetch_requires_network", "post_download_reading_is_offline", "dependency_free_after_download"],
      "properties": {
        "initial_fetch_requires_network": { "const": true },
        "post_download_reading_is_offline": { "const": true },
        "dependency_free_after_download": { "const": true }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "course_id", "volume", "order", "course_order", "label", "title", "role", "kind", "learner_surface_role", "format", "scope", "pages", "bytes", "sha256", "license", "filename", "url", "state", "verification_scope", "route_granularity", "anchor_status", "offline", "evidence", "machine_data_is_learner_destination"],
      "properties": {
        "action_id": { "type": "string", "pattern": "^(B20|B30|B50|B60):reader:(textbook|problembook|combined)$" },
        "course_id": { "enum": ["B20", "B30", "B50", "B60"] },
        "volume": { "enum": ["CLP1", "CLP2", "CLP3", "CLP4"] },
        "order": { "type": "integer", "minimum": 1, "maximum": 7 },
        "course_order": { "type": "integer", "minimum": 1, "maximum": 2 },
        "label": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "role": { "enum": ["textbook", "problembook", "combined_textbook_problembook"] },
        "kind": { "enum": ["textbook", "problembook", "combined_textbook_problembook"] },
        "learner_surface_role": { "enum": ["default_primary", "learner_primary_companion"] },
        "format": { "const": "application/pdf" },
        "scope": { "enum": ["whole_course", "whole_course_companion", "whole_course_combined_reader"] },
        "pages": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "license": { "const": "CC BY-NC-SA 4.0" },
        "filename": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "api_content_url": { "$ref": "#/$defs/httpsUrl" },
        "state": { "const": "verified" },
        "verification_scope": { "const": "pass_receipt_bound" },
        "route_granularity": { "const": "whole_file_only" },
        "anchor_status": { "const": "not_established" },
        "offline": { "$ref": "#/$defs/offline" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "machine_data_is_learner_destination": { "const": false }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["course_id", "volume", "title", "topic", "level", "prerequisites", "publication", "effective_route_source", "learner_primary_policy", "adapter_consumption_claim", "actions", "known_stale_overlay_urls_replaced"],
      "properties": {
        "course_id": { "enum": ["B20", "B30", "B50", "B60"] },
        "volume": { "enum": ["CLP1", "CLP2", "CLP3", "CLP4"] },
        "title": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "minLength": 1 },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "publication": { "$ref": "#/$defs/publication" },
        "effective_route_source": { "const": "sealed_clp_learner_route_evidence" },
        "learner_primary_policy": { "const": "whole_file_pdf_only" },
        "adapter_consumption_claim": { "const": false },
        "actions": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/action" } },
        "known_stale_overlay_urls_replaced": { "type": "array", "items": { "$ref": "#/$defs/httpsUrl" } }
      }
    }
  }
}
