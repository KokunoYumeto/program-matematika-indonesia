{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/course-capsule-v1/v2/canonical-terminology-register-policy-v1.schema.json",
  "title": "Program Matematika Indonesia canonical terminology and register policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_id",
    "schema_version",
    "policy_id",
    "locale",
    "status",
    "scope",
    "source_basis",
    "decision_procedure",
    "designation_policy",
    "register_policy",
    "termbase_contract",
    "conflict_inventory",
    "probability_family_audit",
    "deterministic_propagation",
    "change_log",
    "unresolved_evidence_gaps"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema_id": { "const": "interlanguage/program-matematika-indonesia-canonical-terminology-register-policy/v1" },
    "schema_version": { "const": "1.0.0" },
    "policy_id": { "const": "urn:interlanguage:program-matematika-indonesia:terminology-policy:v1" },
    "locale": { "const": "id-ID" },
    "status": { "const": "normative_for_central_integration" },
    "scope": { "type": "object" },
    "source_basis": { "type": "array", "minItems": 8, "items": { "type": "object" } },
    "decision_procedure": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "rule_id", "rule"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "rule_id": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 }
        }
      }
    },
    "designation_policy": { "type": "object" },
    "register_policy": { "type": "object" },
    "termbase_contract": { "type": "object" },
    "conflict_inventory": { "type": "array", "items": { "type": "object" } },
    "probability_family_audit": { "type": "object" },
    "deterministic_propagation": { "type": "object" },
    "change_log": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "unresolved_evidence_gaps": { "type": "array", "items": { "type": "object" } }
  }
}
