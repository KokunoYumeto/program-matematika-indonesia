{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schemas/course-capsule-v1/geometry-learning-capability-v1.schema.json",
  "type": "object",
  "required": ["contract", "role", "locale", "native_edition", "counts", "concepts", "terms", "figures", "exercises", "corrections", "chapter_dependencies", "chapters", "rights_accessibility", "native_record_counts", "projection_policy", "limitations"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "geometry-learning-capability/1"},
    "role": {"const": "C100"}, "locale": {"const": "id-ID"},
    "native_edition": {"type": "object", "required": ["id", "commit", "tree", "rights_id"]},
    "counts": {"type": "object"},
    "concepts": {"type": "array", "minItems": 491, "maxItems": 491, "items": {"type": "object", "required": ["id", "native", "source_file", "reading", "reading_state", "fallback_evidence", "prerequisites", "lexical_term_matches"]}},
    "terms": {"type": "array", "minItems": 432, "maxItems": 432, "items": {"type": "object", "required": ["id", "native"]}},
    "figures": {"type": "array", "minItems": 214, "maxItems": 214, "items": {"type": "object", "required": ["id", "native", "reading", "reading_state", "native_illustrates_relations"]}},
    "exercises": {"type": "array", "minItems": 285, "maxItems": 285, "items": {"type": "object", "required": ["id", "unit", "native_exercise_row", "chapter", "parents", "support", "support_state", "learner_url"]}},
    "corrections": {"type": "array", "minItems": 207, "maxItems": 207, "items": {"type": "object", "required": ["id", "entity_type", "status"]}},
    "chapter_dependencies": {"type": "array"}, "chapters": {"type": "array", "minItems": 20, "maxItems": 20},
    "rights_accessibility": {"type": "object"}, "native_record_counts": {"type": "object"},
    "projection_policy": {"type": "object"}, "limitations": {"type": "array", "minItems": 5, "items": {"type": "string"}}
  }
}
