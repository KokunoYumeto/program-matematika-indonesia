{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/course-capsule-v1/native-catalog-record-v1.schema.json",
  "title": "Lossless native catalog record envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "dataset", "table", "ordinal", "native_id", "payload"],
  "properties": {
    "contract": {"const": "native-catalog-exchange/1"},
    "dataset": {"type": "string", "minLength": 1},
    "table": {"type": "string", "minLength": 1},
    "ordinal": {"type": "integer", "minimum": 0},
    "native_id": {"type": ["string", "null"]},
    "payload": {}
  }
}
