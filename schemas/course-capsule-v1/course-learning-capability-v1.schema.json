{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokunoyumeto.github.io/program-matematika-indonesia/schema/course-capsule-v1/course-learning-capability-v1.schema.json",
  "title": "Shared native learner and educator capability map",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "course_id", "locale", "native_dataset", "source_catalog", "units", "prerequisite_routes", "labs", "environments", "artifacts", "sources", "external_relation_nodes", "limitations"],
  "properties": {
    "contract": {"const": "course-learning-capability/1"},
    "course_id": {"type": "string", "pattern": "^[A-D][0-9]{2,3}$"},
    "locale": {"type": "string", "minLength": 2},
    "native_dataset": {"type": "string", "minLength": 1},
    "source_catalog": {"type": "object", "required": ["path", "bytes", "sha256", "url"], "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "url": {"type": "string", "format": "uri"}}, "additionalProperties": false},
    "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}},
    "prerequisite_routes": {"type": "array", "items": {"type": "object", "required": ["id", "unit", "prerequisite", "required_for_course", "sections", "exercises", "href"], "properties": {"required_for_course": {"type": "boolean"}}}},
    "labs": {"type": "array", "items": {"type": "object", "required": ["id", "unit", "environment", "exercise_ids", "artifact_ids"]}},
    "environments": {"type": "array", "items": {"type": "object", "required": ["id", "runtime_version", "lock"]}},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "path"]}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["id", "role", "license", "identity"]}},
    "external_relation_nodes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "support": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "source_anchor", "label", "href"],
      "properties": {"status": {"enum": ["complete", "executable", "not_present", "pending"]}, "source_anchor": {"type": "string"}, "label": {"type": ["string", "null"]}, "href": {"type": ["string", "null"], "format": "uri"}},
      "allOf": [{"if": {"properties": {"status": {"enum": ["complete", "executable"]}}}, "then": {"properties": {"href": {"type": "string", "format": "uri"}}}, "else": {"properties": {"href": {"type": "null"}}}}]
    },
    "exercise": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "unit_id", "title", "kind", "sequence", "curriculum_status", "href", "hint", "check", "solution"],
      "properties": {"id": {"type": "string"}, "unit_id": {"type": "string"}, "title": {"type": "string"}, "kind": {"type": "string"}, "sequence": {"type": "integer", "minimum": 1}, "curriculum_status": {"type": "string"}, "href": {"type": "string", "format": "uri"}, "hint": {"$ref": "#/$defs/support"}, "check": {"$ref": "#/$defs/support"}, "solution": {"$ref": "#/$defs/support"}}
    },
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "href", "sections", "objectives_href", "previous_units", "components", "exercises"],
      "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "href": {"type": "string", "format": "uri"}, "sections": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "objectives_href": {"type": ["string", "null"], "format": "uri"}, "previous_units": {"type": "array", "items": {"type": "string"}}, "components": {"type": "array", "items": {"type": "object", "required": ["id", "source", "license"]}}, "exercises": {"type": "array", "items": {"$ref": "#/$defs/exercise"}}}
    }
  }
}
